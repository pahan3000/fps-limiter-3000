<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:FPSLimiter">

    <!-- Typography is pinned here (Desktop values). Taking it from Playnite's active theme made the popup
         look much bigger/different in Fullscreen, whose theme defines larger fonts. -->
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>

    <SolidColorBrush x:Key="ReShadeBg"           Color="#FF171D25"/>
    <SolidColorBrush x:Key="ReShadePanelBg"      Color="#FF23262E"/>
    <SolidColorBrush x:Key="ReShadeBorder"       Color="#FF3D4450"/>
    <SolidColorBrush x:Key="ReShadeBorderHover"  Color="#FF434953"/>
    <SolidColorBrush x:Key="ReShadeText"         Color="#FFDCDEDF"/>
    <SolidColorBrush x:Key="ReShadeTextMuted"    Color="#FFB8BCBF"/>
    <SolidColorBrush x:Key="ReShadeAccent"       Color="#FF4A9EFF"/>
    <SolidColorBrush x:Key="ReShadeAccentHover"  Color="#FF6BB0FF"/>
    <SolidColorBrush x:Key="ReShadeAccentPress"  Color="#FF2E7AD1"/>
    <SolidColorBrush x:Key="ReShadeAccentSoft"   Color="#FF1A2A40"/>
    <SolidColorBrush x:Key="ReShadeDanger"       Color="#FFE05555"/>
    <SolidColorBrush x:Key="ReShadeDangerHover"  Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="ReShadeControlBg"    Color="#FF2A2D34"/>
    <SolidColorBrush x:Key="ReShadeControlHover" Color="#FF3D4450"/>
    <SolidColorBrush x:Key="UiPopupBg"            Color="#FF23262E"/>
    <SolidColorBrush x:Key="ReShadeDisabled"     Color="#FF55555E"/>
    <SolidColorBrush x:Key="ReShadeSuccess"      Color="#FF3DCF7A"/>

    <!-- Defaults are overridden locally for the selected appearance preset. -->
    <FontWeight x:Key="UiEmphasisFontWeight">Normal</FontWeight>
    <SolidColorBrush x:Key="UiButton" Color="#FF2F333B"/>
    <CornerRadius x:Key="UiButtonCornerRadius">2</CornerRadius>
    <SolidColorBrush x:Key="UiPrimary" Color="#FF2F65A0"/>
    <SolidColorBrush x:Key="UiPrimaryText" Color="#FFF1F4FA"/>
    <SolidColorBrush x:Key="SwitchTrackOffBrush" Color="#FF3D4149"/>
    <SolidColorBrush x:Key="SwitchTrackOnBrush" Color="#FF1A9FFF"/>
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="#FFF5F6F7"/>
    <SolidColorBrush x:Key="SwitchThumbOnBrush" Color="#FFF5F6F7"/>
    <SolidColorBrush x:Key="SwitchTrackBorderBrush" Color="#003D4149"/>
    <SolidColorBrush x:Key="UiStatusBg" Color="#FF1E2A3A"/>
    <sys:Double x:Key="SwitchThumbSize">16</sys:Double>
    <Thickness x:Key="SwitchThumbLeftMargin">2,0,0,0</Thickness>
    <Thickness x:Key="SwitchThumbRightMargin">0,0,2,0</Thickness>
    <Thickness x:Key="GameSwitchThumbLeftMargin">3,0,0,0</Thickness>
    <Thickness x:Key="GameSwitchThumbRightMargin">0,0,3,0</Thickness>
    <CornerRadius x:Key="UiGameButtonCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="UiSectionCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="UiSectionHeaderCornerRadius">7,7,0,0</CornerRadius>
    <CornerRadius x:Key="UiSectionContentCornerRadius">0,0,7,7</CornerRadius>
    <SolidColorBrush x:Key="ComboSelectedBg" Color="#FF314B68"/>
    <SolidColorBrush x:Key="GameSwitchTrackOff" Color="#FF303037"/>
    <SolidColorBrush x:Key="GameSwitchTrackBorder" Color="#FF3A3A42"/>
    <SolidColorBrush x:Key="GameSwitchThumb" Color="#FFE9E9EC"/>
    <SolidColorBrush x:Key="GameSwitchThumbOn" Color="#FFE9E9EC"/>
    <SolidColorBrush x:Key="UiHeaderHover" Color="#FF303641"/>
    <SolidColorBrush x:Key="UiExpandedHeader" Color="#FF344252"/>
    <SolidColorBrush x:Key="ComboBorderHover" Color="#FF535B68"/>

    <Geometry x:Key="FolderIconGeometry">M2,6 L2,18 Q2,20 4,20 L20,20 Q22,20 22,18 L22,9 Q22,7 20,7 L11,7 L9,5 L4,5 Q2,5 2,6 Z</Geometry>
    <Geometry x:Key="GearIconGeometry">M10,2 L14,2 L14.5,4.4 L16.4,5.2 L18.5,3.9 L21,6.4 L19.7,8.5 L20.5,10.4 L23,11 L23,14 L20.5,14.5 L19.7,16.4 L21,18.5 L18.5,21 L16.4,19.7 L14.5,20.5 L14,23 L10,23 L9.5,20.5 L7.6,19.7 L5.5,21 L3,18.5 L4.3,16.4 L3.5,14.5 L1,14 L1,11 L3.5,10.4 L4.3,8.5 L3,6.4 L5.5,3.9 L7.6,5.2 L9.5,4.4 Z M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z</Geometry>
    <Geometry x:Key="LayersIconGeometry">M2,8 L12,3 L22,8 L12,13 Z M2,12 L12,17 L22,12 M2,16 L12,21 L22,16</Geometry>
    <Geometry x:Key="SlidersIconGeometry">M2,6 L8,6 M12,6 L22,6 M2,12 L14,12 M18,12 L22,12 M2,18 L5,18 M9,18 L22,18 M8,4 L12,4 L12,8 L8,8 Z M14,10 L18,10 L18,14 L14,14 Z M5,16 L9,16 L9,20 L5,20 Z</Geometry>
    <Geometry x:Key="SpeedIconGeometry">M3,19 A10,10 0 1 1 21,19 M12,17 L16,10 M12,17 L12,17 M6,12 L7,12 M12,6 L12,7 M18,12 L17,12</Geometry>
    <!-- White stroke marks (same style as Downloads / Updates / Notifications). -->
    <!-- RTSS: minimal gauge -->
    <Geometry x:Key="RtssIconGeometry">M4,18 A8,8 0 1 1 20,18 M12,18 L16,10</Geometry>
    <!-- Special K: monogram K -->
    <Geometry x:Key="SpecialKIconGeometry">M6,4 L6,20 M6,12 L18,4 M6,12 L18,20</Geometry>
    <Geometry x:Key="CubeIconGeometry">M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M3,7 L12,12 L21,7 M12,12 L12,22</Geometry>
    <Geometry x:Key="UpdateIconGeometry">M20,8 A8,8 0 0 0 6,6 L3,9 M3,4 L3,9 L8,9 M4,16 A8,8 0 0 0 18,18 L21,15 M21,20 L21,15 L16,15</Geometry>
    <Geometry x:Key="DownloadIconGeometry">M12,3 L12,16 M7,11 L12,16 L17,11 M3,18 L3,21 L21,21 L21,18</Geometry>
    <Geometry x:Key="ClockIconGeometry">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,6 L12,12 L16,14</Geometry>
    <Geometry x:Key="ShieldIconGeometry">M12,2 L21,6 L20,14 Q18,20 12,22 Q6,20 4,14 L3,6 Z</Geometry>
    <Geometry x:Key="PuzzleIconGeometry">M3,4 L9,4 C8,1 13,1 13,4 L20,4 L20,10 C23,9 23,14 20,14 L20,20 L14,20 C15,23 10,23 10,20 L3,20 L3,14 C6,15 6,10 3,10 Z</Geometry>
    <Geometry x:Key="FileIconGeometry">M5,2 L15,2 L20,7 L20,22 L5,22 Z M15,2 L15,7 L20,7 M8,12 L17,12 M8,16 L17,16</Geometry>
    <Geometry x:Key="SearchIconGeometry">M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21</Geometry>
    <Geometry x:Key="ControllerIconGeometry">M6,8 L18,8 Q21,8 22,12 L23,17 Q23,20 20,20 L16,17 L8,17 L4,20 Q1,20 1,17 L2,12 Q3,8 6,8 Z M6,11 L6,15 M4,13 L8,13 M17,12 L17,12 M20,14 L20,14</Geometry>
    <Geometry x:Key="BellIconGeometry">M5,17 L7,14 L7,10 A5,5 0 0 1 17,10 L17,14 L19,17 Z M10,20 Q12,22 14,20</Geometry>
    <Geometry x:Key="KeyboardIconGeometry">M3,5 L21,5 L21,19 L3,19 Z M6,9 L7,9 M10,9 L11,9 M14,9 L15,9 M18,9 L19,9 M6,13 L7,13 M10,13 L11,13 M14,13 L15,13 M18,13 L19,13 M7,16 L17,16</Geometry>
    <Geometry x:Key="PaletteIconGeometry">M12,2 A10,10 0 1 0 12,22 L14,22 Q16,22 16,20 Q16,18 18,18 Q22,18 22,13 A10,10 0 0 0 12,2 Z M6.2,9 A0.8,0.8 0 1 0 7.8,9 A0.8,0.8 0 1 0 6.2,9 Z M10.2,6 A0.8,0.8 0 1 0 11.8,6 A0.8,0.8 0 1 0 10.2,6 Z M15.2,7 A0.8,0.8 0 1 0 16.8,7 A0.8,0.8 0 1 0 15.2,7 Z M18.2,11 A0.8,0.8 0 1 0 19.8,11 A0.8,0.8 0 1 0 18.2,11 Z</Geometry>
    <Style x:Key="Win11OutlineIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>

    <!-- Window chrome -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource ReShadeBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="{DynamicResource ReShadeBg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
    </Style>

    <Style x:Key="ReShadeMutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource ReShadeTextMuted}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
    </Style>

    <Style x:Key="ReShadeSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="{DynamicResource UiEmphasisFontWeight}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
    </Style>

    <!-- Bordered panel -->
    <Style x:Key="ReShadePanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ReShadePanelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ReShadeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <!-- Button base -->
    <Style TargetType="Button">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="Background" Value="{DynamicResource ReShadeControlBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ReShadeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ReShadeControlHover}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ReShadeBorderHover}"/>
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="local:FpsFocus.GamepadActive" Value="True"/></MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ReShadeText}"/>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ReShadeControlHover}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ReShadeAccentPress}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ReShadeAccentPress}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ReShadeBg}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ReShadeBorder}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ReShadeDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary button — muted solid fill -->
    <Style x:Key="ReShadePrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#FF2A4A72"/>
        <Setter Property="BorderBrush" Value="#FF355A88"/>
        <Setter Property="Foreground" Value="#FFF0F4FA"/>
        <Setter Property="FontWeight" Value="{DynamicResource UiEmphasisFontWeight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF355A88"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#FF4A7AB0"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF1E3A5C"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#FF2A4A72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ReShadeDisabled}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ReShadeDisabled}"/>
                            <Setter Property="Foreground" Value="#AAFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger button (Remove) -->
    <Style x:Key="ReShadeDangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="BorderBrush" Value="#FF5A3030"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeDanger}"/>
        <Setter Property="Background" Value="#FF2A1A1A"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF3A2222"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ReShadeDanger}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ReShadeDangerHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF4A2828"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ReShadeDisabled}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ReShadeBorder}"/>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ReShadeBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox -->
    <Style TargetType="CheckBox">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                Background="{DynamicResource ReShadeControlBg}"
                                BorderBrush="{DynamicResource ReShadeBorder}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="check" Data="M2,7 L6,11 L14,2" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource ReShadeAccent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ReShadeAccent}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ReShadeAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ReShadeDisabled}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ReShadeDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle-switch -->
    <Style x:Key="ReShadeToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel LastChildFill="True">
                        <Border x:Name="track" DockPanel.Dock="Left" Width="40" Height="22" CornerRadius="11"
                                Background="{DynamicResource ReShadeControlBg}"
                                BorderBrush="{DynamicResource ReShadeBorder}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Border x:Name="knob" Width="16" Height="16" CornerRadius="8"
                                    Background="{DynamicResource ReShadeTextMuted}"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource ReShadeAccent}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource ReShadeAccent}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                            <Setter TargetName="knob" Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource ReShadeBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ReShadeDisabled}"/>
                            <Setter TargetName="track" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="Background" Value="{DynamicResource ReShadeControlBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ReShadeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource ReShadeAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ReShadeBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ReShadeAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ReShadeDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Border" Grid.ColumnSpan="2"
                    Background="{DynamicResource ReShadeControlBg}"
                    BorderBrush="{DynamicResource ReShadeBorderHover}"
                    BorderThickness="1"
                    CornerRadius="6"/>
            <Border Grid.Column="0" Margin="1" Background="Transparent" CornerRadius="4,0,0,4"/>
            <Path x:Name="Arrow" Grid.Column="1"
                  Data="M0,0 L4,4 L8,0"
                  Stroke="#FFCBD2DB"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ReShadeControlHover}"/>
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ComboBorderHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ReShadeAccent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Border" Property="Opacity" Value="0.6"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="Background" Value="{DynamicResource ReShadeControlBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ReShadeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource ComboBoxToggleButton}"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="12,5,34,5"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"/>
                        <Border x:Name="FocusRing" BorderBrush="{DynamicResource ReShadeText}" BorderThickness="2" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource UiPopupBg}"
                                        BorderBrush="{DynamicResource ReShadeBorderHover}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Margin="0,3,0,0"/>
                                <ScrollViewer Margin="4,7,4,4" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ReShadeDisabled}"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                        </Trigger>
                        <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True"/>
                          <Condition Property="local:FpsFocus.GamepadActive" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="5"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="2,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ReShadeControlHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboSelectedBg}"/>
                                        <Setter Property="Foreground" Value="#FFF1F5FA"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource ReShadeDisabled}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListBox (addons list) -->
    <Style TargetType="ListBox">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="Background" Value="{DynamicResource ReShadeControlBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ReShadeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False" Padding="2">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
                    <Setter Property="Padding" Value="4,3"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ReShadeAccentSoft}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ReShadeAccentSoft}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Progress bar -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource ReShadeControlBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeAccent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="1.5" Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Track" CornerRadius="1.5" Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="1.5" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ReShadeStatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeTextMuted}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
    </Style>


    <!-- Settings-style toggle: label on the left, track on the right. -->
    <Style x:Key="OverlaySettingsSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" RecognizesAccessKey="True"/>
                <TextBlock x:Name="State" Grid.Column="1" Text="Off" Visibility="{DynamicResource Windows11Only}" VerticalAlignment="Center" Margin="0,0,9,0" Foreground="{DynamicResource ReShadeText}"/>
                <Grid Grid.Column="2" Width="40" Height="20">
                  <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource SwitchTrackOffBrush}" BorderBrush="{DynamicResource SwitchTrackBorderBrush}" BorderThickness="1"/>
                  <Ellipse x:Name="Thumb" Width="{DynamicResource SwitchThumbSize}" Height="{DynamicResource SwitchThumbSize}" Fill="{DynamicResource SwitchThumbBrush}" HorizontalAlignment="Left" Margin="{DynamicResource SwitchThumbLeftMargin}"/>
                </Grid>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource SwitchTrackOnBrush}"/>
                  <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SwitchTrackOnBrush}"/>
                  <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource SwitchThumbOnBrush}"/>
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="Thumb" Property="Margin" Value="{DynamicResource SwitchThumbRightMargin}"/>
                  <Setter TargetName="State" Property="Text" Value="On"/>
                </Trigger>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="local:FpsFocus.GamepadActive" Value="True"/></MultiTrigger.Conditions>
                  <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ReShadeText}"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
    </Style>

      <ControlTemplate x:Key="UnifiedSectionTemplate" TargetType="Expander">
        <Border x:Name="Outer" Background="{DynamicResource UiCard}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="{DynamicResource UiSectionCornerRadius}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" MinHeight="42"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderBg" Grid.Row="0" Background="Transparent" CornerRadius="{DynamicResource UiSectionHeaderCornerRadius}">
              <Grid>
                <Border x:Name="ExpandedAccent" Width="3" HorizontalAlignment="Left" Margin="0,8,0,8" CornerRadius="1.5" Background="{DynamicResource ReShadeAccent}" Visibility="Collapsed" IsHitTestVisible="False"/>
                <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="13,0">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                      <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Content" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                      </Border>
                      <Border x:Name="FocusRing" BorderBrush="{DynamicResource ReShadeText}" BorderThickness="2" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True"/>
                          <Condition Property="local:FpsFocus.GamepadActive" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                  </ToggleButton.Template>
                  <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                </ToggleButton>
              </Grid>
            </Border>
            <Border x:Name="ContentBorder" Grid.Row="1" Visibility="Collapsed" BorderBrush="{DynamicResource UiDivider}" BorderThickness="0,1,0,0" Padding="14,12,14,14" Background="{DynamicResource ReShadeBg}" CornerRadius="{DynamicResource UiSectionContentCornerRadius}">
              <ContentPresenter ContentSource="Content"/>
            </Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource UiBorderHover}"/>
            <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource UiCardHover}"/>
          </Trigger>
          <Trigger Property="IsExpanded" Value="True">
            <Setter TargetName="ContentBorder" Property="Visibility" Value="Visible"/>
            <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource UiExpandedHeader}"/>
            <Setter TargetName="ExpandedAccent" Property="Visibility" Value="Visible"/>
            <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource UiBorderHover}"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <!-- Separate neutral cards follow Windows Settings; open state stays clear without arrows. -->
      <ControlTemplate x:Key="Windows11SectionTemplate" TargetType="Expander">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="52"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border x:Name="HeaderBg" Background="{DynamicResource UiCard}" CornerRadius="4">
            <Grid>
              <Border x:Name="ExpandedAccent" Width="3" HorizontalAlignment="Left" Margin="0,9,0,9" CornerRadius="1.5" Background="{DynamicResource ReShadeAccent}" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False"/>
              <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" Padding="16,12" HorizontalContentAlignment="Stretch">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                      <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Content" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                      </Border>
                      <Border x:Name="FocusRing" BorderBrush="{DynamicResource ReShadeText}" BorderThickness="2" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True"/>
                          <Condition Property="local:FpsFocus.GamepadActive" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
              </ToggleButton>
            </Grid>
          </Border>
          <ContentPresenter x:Name="ContentSite" Grid.Row="1" Visibility="Collapsed" ContentSource="Content" Margin="0,5,0,0"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource UiHeaderHover}"/>
          </Trigger>
          <Trigger Property="IsExpanded" Value="True">
            <Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/>
            <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource UiExpandedHeader}"/>
            <Setter TargetName="ExpandedAccent" Property="Visibility" Value="Visible"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="TreeBranchExpander" TargetType="Expander">
        <Setter Property="IsExpanded" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="Template" Value="{StaticResource Windows11SectionTemplate}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
      </Style>


    <!-- RadioButton matching the switches/cards; inherits Playnite font -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0,2">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource ReShadeBorderHover}" StrokeThickness="1.5" Fill="{DynamicResource ReShadeControlBg}"/>
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource ReShadeAccent}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ReShadeAccent}"/>
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="local:FpsFocus.GamepadActive" Value="True"/></MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ReShadeText}"/>
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2.5"/>
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ReShadeAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ThemeRadio" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}"/>
</ResourceDictionary>
