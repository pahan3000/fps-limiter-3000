<Window x:Class="FPSLimiter.GameSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Limiter 3000"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Margin="16">
            <TextBlock x:Name="GameTitleText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <Expander IsExpanded="True" Margin="0,0,0,8">
                <Expander.Header><TextBlock Text="General" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Margin="8,6,0,4">
                    <Border Margin="0,0,0,12" Padding="12,10" Background="#18FFFFFF" CornerRadius="6">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Use Special K" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BackendStatusText" Opacity="0.85" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="UseSpecialKToggle" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Checked="OnUseSpecialKChanged" Unchecked="OnUseSpecialKChanged"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="Local injection" FontWeight="SemiBold" Margin="0,4,0,6"/>
                    <TextBlock x:Name="LocalInjectionStatusText" Opacity="0.75" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Inject" MinWidth="88" Margin="0,0,8,0" Padding="10,5" Click="OnLocalInjectClick"
                                ToolTip="Copy SpecialK DLL into the game folder as dxgi.dll"/>
                        <Button Content="Remove" MinWidth="88" Padding="10,5" Click="OnLocalRemoveClick"
                                ToolTip="Remove Special K wrapper DLLs from the game folder"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander IsExpanded="True" Margin="0,0,0,8">
                <Expander.Header><TextBlock Text="FPS cap latency settings" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Margin="8,6,0,4">
                    <TextBlock Text="FPS cap" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock x:Name="CurrentFpsText" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="PresetList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                        <Button Content="Custom…" MinWidth="90" Margin="0,0,8,0" Padding="10,5" Click="OnCustomClick"/>
                        <Button Content="Use global" MinWidth="90" Margin="0,0,8,0" Padding="10,5" Click="OnUseGlobalClick"/>
                        <Button Content="Disable" MinWidth="90" Padding="10,5" Click="OnDisableClick"/>
                    </StackPanel>
                    <TextBlock Text="Special K limiter mode" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <ComboBox x:Name="SkModeCombo" Margin="0,0,0,4" SelectionChanged="OnSkModeChanged"/>
                </StackPanel>
            </Expander>

            <Expander IsExpanded="True" Margin="0,0,0,8">
                <Expander.Header><TextBlock Text="Compatibility" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Margin="8,6,0,4">
                    <TextBlock Text="Disable Steam API" FontWeight="SemiBold"/>
                    <CheckBox x:Name="SteamSilentToggle" Margin="0,6,0,0"
                              Checked="OnSteamSilentChanged" Unchecked="OnSteamSilentChanged"/>
                    <TextBlock Text="Steam overlay options follow the global Special K Compatibility settings."
                               Opacity="0.75" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

            <TextBlock Text="Sync mode (RTSS)" FontWeight="SemiBold" Margin="0,4,0,6"/>
            <ComboBox x:Name="SyncModeCombo" Margin="0,0,0,16" SelectionChanged="OnSyncModeChanged"/>

            <Button Content="Close" HorizontalAlignment="Right" MinWidth="100" Padding="12,6"
                    IsCancel="True" IsDefault="True" Click="OnCloseClick"/>
        </StackPanel>
    </ScrollViewer>
</Window>
