<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="FpsBg"          Color="#FF16161A"/>
    <SolidColorBrush x:Key="FpsPanelBg"     Color="#FF1E1E22"/>
    <SolidColorBrush x:Key="FpsBorder"      Color="#FF2E2E34"/>
    <SolidColorBrush x:Key="FpsText"        Color="#FFE8E8EC"/>
    <SolidColorBrush x:Key="FpsMuted"       Color="#FF9A9AA3"/>
    <SolidColorBrush x:Key="FpsAccent"      Color="#FF4A9EFF"/>
    <SolidColorBrush x:Key="FpsAccentHover" Color="#FF6BB0FF"/>
    <SolidColorBrush x:Key="FpsDanger"      Color="#FFE05555"/>
    <SolidColorBrush x:Key="FpsDangerHover" Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="FpsSuccess"     Color="#FF4CAF50"/>
    <SolidColorBrush x:Key="FpsDisabled"    Color="#FF5A5A62"/>
    <SolidColorBrush x:Key="SwitchTrackOffBrush" Color="#3A3A42"/>
    <SolidColorBrush x:Key="SwitchTrackOnBrush" Color="#4A9EFF"/>
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="#F2F2F5"/>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FpsText}"/>
    </Style>

    <Style x:Key="FpsMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FpsMuted}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="FpsSectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FpsText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="FpsPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FpsPanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FpsBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <Style x:Key="SwitchRowStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="40" Height="22" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="11"
                                Background="{StaticResource SwitchTrackOffBrush}"
                                BorderBrush="#FF2E2E34" BorderThickness="1"/>
                        <Ellipse x:Name="Thumb" Width="16" Height="16"
                                 Fill="{StaticResource SwitchThumbBrush}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource SwitchTrackOnBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SwitchTrackOnBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource FpsText}"/>
        <Setter Property="Background" Value="#FF2A2A30"/>
        <Setter Property="BorderBrush" Value="{StaticResource FpsBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF35353C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF404048"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FpsPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#FF1A3050"/>
        <Setter Property="BorderBrush" Value="#FF2A5080"/>
        <Setter Property="Foreground" Value="{StaticResource FpsAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FpsDangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#FF2A1A1A"/>
        <Setter Property="BorderBrush" Value="#FF5A3030"/>
        <Setter Property="Foreground" Value="{StaticResource FpsDanger}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FpsPresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Padding" Value="6,10"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="FpsPresetButtonActive" TargetType="Button" BasedOn="{StaticResource FpsPresetButton}">
        <Setter Property="Background" Value="#FF1A3A22"/>
        <Setter Property="BorderBrush" Value="{StaticResource FpsSuccess}"/>
        <Setter Property="Foreground" Value="#FFB6F5B0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource FpsText}"/>
        <Setter Property="Background" Value="#FF2A2A30"/>
        <Setter Property="BorderBrush" Value="{StaticResource FpsBorder}"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>
</ResourceDictionary>
