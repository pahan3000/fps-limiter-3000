<UserControl x:Class="FPSLimiterSettingsUI.FPSLimiterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FPSLimiter"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="880">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="ExtensionTheme.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:LimitDisplayConverter x:Key="LimitDisplay" />
        <Style x:Key="DownloadCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource UiCard}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource DownloadCard}"/>
        <Style x:Key="SubHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource ReShadeTextMuted}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="Margin" Value="4,8,0,6"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
                    </Style>
        <Style x:Key="CardDesc" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource ReShadeTextMuted}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="BadgeBase" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BadgeGreen" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
            <Setter Property="Background" Value="{DynamicResource BadgeOkBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeOkBorder}"/>
        </Style>
        <Style x:Key="BadgeTextGreen" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BadgeOkText}"/>
        </Style>
        <Style x:Key="CardSecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="CardPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="HotkeyCaptureTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
            <Setter Property="Background" Value="{DynamicResource ReShadeControlBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ReShadeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DownloadTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ReShadeTextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Background="Transparent" CornerRadius="15" Padding="18,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource UiCard}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource UiPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource UiPrimaryText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InstallButton" TargetType="Button" BasedOn="{StaticResource CardPrimaryButton}">
            <Setter Property="Content" Value="Install"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Content" Value="Reinstall"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SyncModeOptionTemplate">
            <StackPanel MaxWidth="360">
                <TextBlock Text="{Binding DisplayName}"/>
                <!-- Description only shows inside the open dropdown (it has a ComboBoxItem ancestor), not in the closed box. -->
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,2"
                           FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource ReShadeTextMuted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBoxItem}}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <!-- The selected monitor/resolution shares one compact pair of game-type rows. -->
        <DataTemplate x:Key="MonitorLimitRows">
            <StackPanel>
                <Border Background="{DynamicResource UiCard}" BorderBrush="{DynamicResource ReShadeBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="18,14,18,16" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Windows games" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <CheckBox Content="On" IsChecked="{Binding Windows.Enabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border BorderBrush="{DynamicResource UiDivider}" BorderThickness="0,1,0,0" Margin="0,12,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static local:LimitUnits.State}, Path=LimitLabel}" Style="{StaticResource CardDesc}" Margin="2,0,0,6"/>
                                <Grid>
                                    <TextBox Text="{Binding Windows.FrameLimitText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding Windows.Enabled}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                             Padding="12,0,40,0" MinHeight="40"/>
                                    <TextBlock Text="{Binding Source={x:Static local:LimitUnits.State}, Path=Suffix}" IsHitTestVisible="False"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Foreground="{DynamicResource ReShadeTextMuted}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sync" Style="{StaticResource CardDesc}" Margin="2,0,0,6"/>
                                <ComboBox ItemsSource="{Binding DataContext.SyncModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          ItemTemplate="{StaticResource SyncModeOptionTemplate}" SelectedValuePath="Value"
                                          SelectedValue="{Binding Windows.SyncMode}" IsEnabled="{Binding Windows.Enabled}"
                                          HorizontalContentAlignment="Left" MinHeight="40"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Reflex" Style="{StaticResource CardDesc}" Margin="2,0,0,6"/>
                                <ComboBox ItemsSource="{Binding DataContext.ReflexMarkerOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                          SelectedValue="{Binding Windows.ReflexMarkers}" HorizontalContentAlignment="Left" MinHeight="40"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource UiCard}" BorderBrush="{DynamicResource ReShadeBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="18,14,18,16" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Non-Windows games" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <CheckBox Content="On" IsChecked="{Binding NonWindows.Enabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border BorderBrush="{DynamicResource UiDivider}" BorderThickness="0,1,0,0" Margin="0,12,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static local:LimitUnits.State}, Path=LimitLabel}" Style="{StaticResource CardDesc}" Margin="2,0,0,6"/>
                                <Grid>
                                    <TextBox Text="{Binding NonWindows.FrameLimitText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding NonWindows.Enabled}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                             Padding="12,0,40,0" MinHeight="40"/>
                                    <TextBlock Text="{Binding Source={x:Static local:LimitUnits.State}, Path=Suffix}" IsHitTestVisible="False"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Foreground="{DynamicResource ReShadeTextMuted}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sync" Style="{StaticResource CardDesc}" Margin="2,0,0,6"/>
                                <ComboBox ItemsSource="{Binding DataContext.SyncModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          ItemTemplate="{StaticResource SyncModeOptionTemplate}" SelectedValuePath="Value"
                                          SelectedValue="{Binding NonWindows.SyncMode}" IsEnabled="{Binding NonWindows.Enabled}"
                                          HorizontalContentAlignment="Left" MinHeight="40"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Reflex" Style="{StaticResource CardDesc}" Margin="2,0,0,6"/>
                                <ComboBox ItemsSource="{Binding DataContext.ReflexMarkerOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                          SelectedValue="{Binding NonWindows.ReflexMarkers}" HorizontalContentAlignment="Left" MinHeight="40"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- OptiScaler-style palette + controls -->
        <SolidColorBrush x:Key="ReShadePanelBg" Color="#FF1E1E22"/>
        <SolidColorBrush x:Key="ReShadeBorder" Color="#FF2E2E34"/>
        <SolidColorBrush x:Key="ReShadeBorderHover" Color="#FF3E3E48"/>
        <SolidColorBrush x:Key="ReShadeText" Color="#FFF0F0F2"/>
        <SolidColorBrush x:Key="ReShadeTextMuted" Color="#FF8B8B96"/>
        <SolidColorBrush x:Key="ReShadeControlBg" Color="#FF28282E"/>
        <SolidColorBrush x:Key="ReShadeControlHover" Color="#FF32323A"/>
        <SolidColorBrush x:Key="ReShadeAccent" Color="#FF4A9EFF"/>
        <SolidColorBrush x:Key="SwitchTrackOffBrush" Color="#FF28282E"/>
        <SolidColorBrush x:Key="SwitchTrackOnBrush" Color="#FF4A9EFF"/>
        <SolidColorBrush x:Key="SwitchThumbBrush" Color="#FFF0F0F2"/>
        <Style x:Key="ReShadePanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ReShadePanelBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ReShadeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ReShadeControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ReShadeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ReShadeControlHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ReShadeBorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource SwitchTrackOffBrush}" BorderBrush="{DynamicResource SwitchTrackBorderBrush}" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Width="{DynamicResource SwitchThumbSize}" Height="{DynamicResource SwitchThumbSize}" Fill="{DynamicResource SwitchThumbBrush}"
                                     HorizontalAlignment="Left" Margin="{DynamicResource SwitchThumbLeftMargin}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SwitchTrackOnBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource SwitchThumbOnBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="{DynamicResource SwitchThumbRightMargin}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Expander" BasedOn="{StaticResource TreeBranchExpander}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource OverlaySettingsSwitch}">
                    </Style>
      </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource ReShadeBg}">
        <StackPanel Margin="24,20,24,24" HorizontalAlignment="Stretch">

            <!-- General -->
            <Expander x:Name="GeneralSection" IsExpanded="True" Expanded="MainSection_Expanded" Margin="0,0,0,6">
                <Expander.Header><StackPanel Orientation="Horizontal"><Path Data="{DynamicResource GearIconGeometry}" Stroke="{DynamicResource ReShadeText}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,0,13,0"/><TextBlock Text="General" FontWeight="Normal" VerticalAlignment="Center"/></StackPanel></Expander.Header>
                <StackPanel>
                    <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Default FPS limiter backend" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                                      SelectedValue="{Binding Settings.DefaultBackend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36">
                                <ComboBoxItem Content="RTSS" Tag="{x:Static local:LimiterBackendPreference.Rtss}"/>
                                <ComboBoxItem Content="Special K" Tag="{x:Static local:LimiterBackendPreference.SpecialK}"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                        <Grid MinHeight="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Settings theme" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Settings.ThemePreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36">
                                <ComboBoxItem Content="Steam" Tag="Steam"/><ComboBoxItem Content="Steam Dark" Tag="Steam Dark"/><ComboBoxItem Content="Windows 11" Tag="Windows 11"/><ComboBoxItem Content="OLED" Tag="OLED"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="Glass effect" VerticalAlignment="Center" Margin="14,0,8,0"/>
                            <ToggleButton Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Settings.GlassEffect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0" MinHeight="56">
                        <CheckBox Content="Show top bar button" IsChecked="{Binding Settings.ShowTopBarIcon, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- Downloads -->
            <Expander x:Name="DownloadsSection" IsExpanded="False" Expanded="MainSection_Expanded" Margin="0,0,0,6"><Expander.Header><StackPanel Orientation="Horizontal"><Path Data="{DynamicResource DownloadIconGeometry}" Stroke="{DynamicResource ReShadeText}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,0,13,0"/><TextBlock Text="Downloads" FontWeight="Normal" VerticalAlignment="Center"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="DownloadsTabRtss" Style="{StaticResource DownloadTab}" Content="RTSS" GroupName="DownloadsTabs" IsChecked="True" Checked="DownloadsTab_Checked"/>
                        <RadioButton x:Name="DownloadsTabSpecialK" Style="{StaticResource DownloadTab}" Content="Special K" GroupName="DownloadsTabs" Checked="DownloadsTab_Checked"/>
                    </StackPanel>
                    <Border x:Name="RtssDownloadCard" Style="{StaticResource DownloadCard}">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="RTSS"/>
                                <Border x:Name="RtssInstalledBadge" Style="{StaticResource BadgeGreen}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource BadgeTextGreen}" Text="&#x2713; RTSS INSTALLED"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="RtssNotInstalledText" Style="{StaticResource CardDesc}" Text="Not installed"/>
                            <TextBlock Style="{StaticResource CardDesc}" Text="RivaTuner Statistics Server is a PC utility that limits frame rates in games and displays performance overlays."/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button x:Name="DownloadRtssButton" Style="{StaticResource InstallButton}" Click="DownloadRtss_Click" MinHeight="36"/>
                                <Button Content="Homepage" Style="{StaticResource CardSecondaryButton}" Click="OpenRtssHome_Click" MinHeight="36"/>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource ReShadeBorder}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="RTSS Overlay"/>
                                        <Border x:Name="RtssOverlayBadge" Style="{StaticResource BadgeGreen}" Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource BadgeTextGreen}" Text="&#x2713; OVERLAY PRESET INSTALLED"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource CardDesc}" Text="Optional RTSS overlay preset (MyOverlay.ovl) with the Oswald Medium font, installed and set as the RTSS font. Requires RTSS to be installed first."/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button x:Name="InstallRtssOverlayButton" Content="Install overlay preset" Style="{StaticResource CardPrimaryButton}" Click="InstallRtssOverlay_Click" MinHeight="36"
                                                ToolTip="Copies MyOverlay.ovl into RTSS's Plugins\Client\Overlays folder"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border x:Name="SpecialKDownloadCard" Style="{StaticResource DownloadCard}" Visibility="Collapsed">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Special K + SKIF"/>
                                <Border x:Name="SpecialKInstalledBadge" Style="{StaticResource BadgeGreen}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource BadgeTextGreen}" Text="&#x2713; SPECIAL K INSTALLED"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="SpecialKNotInstalledText" Style="{StaticResource CardDesc}" Text="Not installed"/>
                            <TextBlock Style="{StaticResource CardDesc}" Text="Lovingly referred to as the Swiss Army Knife of PC gaming, Special K does a bit of everything."/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button x:Name="DownloadSpecialKButton" Style="{StaticResource InstallButton}" Click="DownloadSpecialK_Click" MinHeight="36"/>
                                <Button Content="Homepage" Style="{StaticResource CardSecondaryButton}" Click="OpenSpecialKHome_Click" MinHeight="36"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DownloadsStatusCard" Style="{StaticResource DownloadCard}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DownloadsStatusText" Style="{StaticResource CardDesc}"/>
                            <ProgressBar x:Name="DownloadsProgressBar" Height="8" Margin="0,8,0,0"
                                         IsIndeterminate="True" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- Updates -->
            <Expander x:Name="UpdatesSection" IsExpanded="False" Expanded="MainSection_Expanded" Margin="0,0,0,6">
                <Expander.Header><StackPanel Orientation="Horizontal"><Path Data="{DynamicResource UpdateIconGeometry}" Stroke="{DynamicResource ReShadeText}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,0,13,0"/><TextBlock Text="Updates" FontWeight="Normal" VerticalAlignment="Center"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,0,0,0">
                <Expander x:Name="ExtensionUpdatesSubSection" IsExpanded="False" Expanded="UpdatesSubSection_Expanded" Margin="0,5,0,0">
                    <Expander.Header><TextBlock Text="FPS Limiter 3000" FontWeight="Normal" VerticalAlignment="Center"/></Expander.Header>
                    <StackPanel Margin="0,5,0,0">
                        <Border Style="{StaticResource DownloadCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding Settings.ExtensionInstalledVersionText, Mode=OneWay}" Style="{StaticResource CardDesc}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="CheckExtensionUpdatesButton" Style="{StaticResource CardSecondaryButton}"
                                            Click="CheckExtensionUpdatesNow_Click" HorizontalAlignment="Left"
                                            MinWidth="166" MinHeight="34" ToolTip="Checks GitHub for a newer FPS Limiter 3000 release.">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{DynamicResource SearchIconGeometry}" Stroke="{DynamicResource ReShadeText}"
                                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Check for FPS Limiter 3000 updates" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="UpdateExtensionNowButton" Content="Update FPS Limiter 3000"
                                            Style="{StaticResource CardPrimaryButton}" Click="UpdateExtensionNow_Click"
                                            HorizontalAlignment="Left" Margin="8,0,0,0" MinHeight="34"
                                            ToolTip="Downloads the new release and opens Playnite's installer. Playnite restarts afterwards."
                                            Visibility="{Binding Settings.HasAvailableExtensionUpdate, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DownloadCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Automatic FPS Limiter 3000 update checks" VerticalAlignment="Center"
                                           ToolTip="You are always asked before anything is installed."/>
                                <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                                          SelectedValue="{Binding Settings.ExtensionUpdateFrequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36">
                                    <ComboBoxItem Content="Check on launch" Tag="{x:Static local:ExtensionUpdateInterval.OnLaunch}"/>
                                    <ComboBoxItem Content="Check weekly" Tag="{x:Static local:ExtensionUpdateInterval.Weekly}"/>
                                    <ComboBoxItem Content="Check monthly" Tag="{x:Static local:ExtensionUpdateInterval.Monthly}"/>
                                    <ComboBoxItem Content="Never" Tag="{x:Static local:ExtensionUpdateInterval.Never}"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border x:Name="ExtUpdatesStatusCard" Style="{StaticResource DownloadCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ExtUpdatesStatusText" Style="{StaticResource CardDesc}"/>
                                <ProgressBar x:Name="ExtUpdatesProgressBar" Height="8" Margin="0,8,0,0"
                                             IsIndeterminate="True" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
            
                </Expander>
                <Expander x:Name="SpecialKUpdatesSubSection" IsExpanded="False" Expanded="UpdatesSubSection_Expanded" Margin="0,5,0,0">
                    <Expander.Header><TextBlock Text="Special K" FontWeight="Normal" VerticalAlignment="Center"/></Expander.Header>
                    <StackPanel Margin="0,5,0,0">
                        <Border Style="{StaticResource DownloadCard}">
                            <Button x:Name="CheckSpecialKUpdatesButton" Style="{StaticResource CardSecondaryButton}"
                                    Click="CheckSpecialKUpdatesNow_Click" HorizontalAlignment="Left"
                                    MinWidth="166" MinHeight="34" ToolTip="Checks the selected Special K update channel (Nightly or Discord).">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource SearchIconGeometry}" Stroke="{DynamicResource ReShadeText}"
                                          StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Check for Special K updates" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border Style="{StaticResource DownloadCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Special K update channel" VerticalAlignment="Center"
                                           ToolTip="Nightly: newest GitHub CI build (main). Discord: the same branch SKIF calls 'Discord (updates regularly)'."/>
                                <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                                          SelectedValue="{Binding Settings.SpecialKUpdateChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36">
                                    <ComboBoxItem Content="Nightly (GitHub main)" Tag="{x:Static local:SpecialKUpdateChannel.Nightly}"/>
                                    <ComboBoxItem Content="Discord (updates regularly)" Tag="{x:Static local:SpecialKUpdateChannel.Discord}"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource DownloadCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Automatic Special K updates" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                                          SelectedValue="{Binding Settings.SpecialKUpdateFrequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36">
                                    <ComboBoxItem Content="Check on launch" Tag="{x:Static local:SpecialKUpdateInterval.OnLaunch}"/>
                                    <ComboBoxItem Content="Check weekly" Tag="{x:Static local:SpecialKUpdateInterval.Weekly}"/>
                                    <ComboBoxItem Content="Check monthly" Tag="{x:Static local:SpecialKUpdateInterval.Monthly}"/>
                                    <ComboBoxItem Content="Check and install on launch" Tag="{x:Static local:SpecialKUpdateInterval.CheckAndInstallOnLaunch}"/>
                                    <ComboBoxItem Content="Never" Tag="{x:Static local:SpecialKUpdateInterval.Never}"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <!-- Special K status / progress -->
                        <Border x:Name="UpdatesStatusCard" Style="{StaticResource DownloadCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="UpdatesStatusText" Style="{StaticResource CardDesc}"/>
                                <ProgressBar x:Name="UpdatesProgressBar" Height="8" Margin="0,8,0,0"
                                             IsIndeterminate="True" Visibility="Collapsed"/>
                                <Button x:Name="UpdateSpecialKNowButton" Content="Update Special K now"
                                        Style="{StaticResource CardPrimaryButton}" Click="UpdateSpecialKNow_Click"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Visibility="{Binding Settings.HasAvailableSpecialKUpdate, Converter={StaticResource BoolToVis}}" MinHeight="36"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
            
                </Expander>
                </StackPanel>
            </Expander>

            <!-- Notifications -->
            <Expander x:Name="NotificationsSection" IsExpanded="False" Expanded="MainSection_Expanded" Margin="0,0,0,6">
                <Expander.Header><StackPanel Orientation="Horizontal"><Path Data="{DynamicResource BellIconGeometry}" Stroke="{DynamicResource ReShadeText}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,0,13,0"/><TextBlock Text="Notifications" FontWeight="Normal" VerticalAlignment="Center"/></StackPanel></Expander.Header>
                <StackPanel>
                    <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                        <CheckBox Content="Notify me when an FPS Limiter 3000 update is available"
                                  IsChecked="{Binding Settings.ExtensionNotifyUpdateAvailable}" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                        <CheckBox Content="Notify me when a Special K update is available"
                                  IsChecked="{Binding Settings.SpecialKNotifyUpdateAvailable}" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                        <CheckBox Content="Notify me when Special K has been updated"
                                  IsChecked="{Binding Settings.SpecialKNotifyUpdateInstalled}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- RTSS -->
            <Expander x:Name="RtssSection" IsExpanded="False" Expanded="MainSection_Expanded" Margin="0,0,0,6"><Expander.Header><StackPanel Orientation="Horizontal"><Image x:Name="RtssSectionIcon" Stretch="Uniform" Width="18" Height="18" Margin="0,0,13,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="RTSS" FontWeight="Normal" VerticalAlignment="Center"/></StackPanel></Expander.Header>
                <StackPanel>
                    <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                        <StackPanel>
                            <TextBlock Text="Executable path" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.RtssPath, UpdateSourceTrigger=PropertyChanged}" MinWidth="360" Margin="0,0,8,0" MinHeight="36"/>
                                <Button Grid.Column="1" Content="Browse" MinWidth="72" Margin="0,0,8,0" Click="BrowseRtssPath_Click" MinHeight="36"/>
                                <Button Grid.Column="2" Content="Open" MinWidth="72" Click="OpenRtssFolder_Click" MinHeight="36"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                        <CheckBox Content="Force DXGI flip model" IsChecked="{Binding Settings.ForceDxgiFlipModel, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                        <CheckBox Content="Automatically start RTSS" IsChecked="{Binding Settings.AutoStartRtss}" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                        <CheckBox Content="Automatically close RTSS" IsChecked="{Binding Settings.AutoCloseRtss}" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test access"
                                    Command="{Binding TestRtssProfilePermissionsCommand}"
                                    MinWidth="110" Margin="0,0,8,0" Padding="8,4" MinHeight="36"/>
                            <Button Content="Set up access…"
                                    Command="{Binding FixRtssProfilePermissionsCommand}"
                                    MinWidth="120" Padding="8,4" MinHeight="36"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- Special K -->
            <Expander x:Name="SpecialKSection" IsExpanded="False" Expanded="MainSection_Expanded" Margin="0,0,0,6"><Expander.Header><StackPanel Orientation="Horizontal"><Image x:Name="SpecialKSectionIcon" Stretch="Uniform" Width="18" Height="18" Margin="0,0,13,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Special K" FontWeight="Normal" VerticalAlignment="Center"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,5,0,0">
                    <!-- General -->
                    <Expander x:Name="SpecialKGeneralSection" IsExpanded="True" Expanded="SpecialKSubsection_Expanded" Margin="0,0,0,6"><Expander.Header><TextBlock Text="General" FontWeight="SemiBold"/></Expander.Header>
                        <StackPanel>
                            <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="Special K folder" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Settings.SpecialKPath, UpdateSourceTrigger=PropertyChanged}" MinWidth="360" Margin="0,0,8,0" MinHeight="36"/>
                                        <Button Grid.Column="1" Content="Browse" MinWidth="72" Margin="0,0,8,0" Click="BrowseSpecialKFolder_Click" MinHeight="36"/>
                                        <Button Grid.Column="2" Content="Open" MinWidth="72" Click="OpenSpecialKFolder_Click" MinHeight="36"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="Injection method" FontWeight="Normal" Margin="0,0,0,6"/>
                                    <RadioButton Content="Local — inject Special K as a DLL into the game folder" GroupName="SkInj" Margin="0,0,0,4"
                                                 IsChecked="{Binding Settings.SpecialKInjectionIsLocal}"/>
                                    <RadioButton Content="Global — inject as a service (the way SKIF handles injection)" GroupName="SkInj"
                                                 IsChecked="{Binding Settings.SpecialKInjectionIsGlobal}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="When to stop the background service" FontWeight="Normal" Margin="0,0,0,6"/>
                                    <RadioButton Content="Keep it running" GroupName="SkStop" Margin="0,0,0,4"
                                                 IsChecked="{Binding Settings.SpecialKStopNever}"/>
                                    <RadioButton Content="After successful injection" GroupName="SkStop" Margin="0,0,0,4"
                                                 IsChecked="{Binding Settings.SpecialKStopAfterInject}"/>
                                    <RadioButton Content="When the game closes" GroupName="SkStop"
                                                 IsChecked="{Binding Settings.SpecialKStopOnExit}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                                <CheckBox Content="Override Special K settings"
                                          IsChecked="{Binding Settings.ApplySpecialKSettingsToExistingProfiles}" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- FPS cap latency settings -->
                    <Expander x:Name="SpecialKLatencySection" IsExpanded="False" Expanded="SpecialKSubsection_Expanded" Margin="0,0,0,6"><Expander.Header><TextBlock Text="FPS cap latency settings" FontWeight="SemiBold"/></Expander.Header>
                        <StackPanel Margin="0,5,0,0" IsEnabled="{Binding Settings.ApplySpecialKSettingsToExistingProfiles}">
                            <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,0,0,5">
                                <StackPanel>
                                    <TextBlock Text="NVIDIA Reflex" FontWeight="Normal" Margin="0,0,0,6"/>
                                    <RadioButton Content="Off" GroupName="SkReflexMode" Margin="0,0,0,4"
                                                 IsChecked="{Binding Settings.SpecialKReflexIsOff}"/>
                                    <RadioButton Content="Low Latency" GroupName="SkReflexMode" Margin="0,0,0,4"
                                                 IsChecked="{Binding Settings.SpecialKReflexIsLowLatency}"/>
                                    <RadioButton Content="Low Latency + Boost" GroupName="SkReflexMode" Margin="0,0,0,8"
                                                 IsChecked="{Binding Settings.SpecialKReflexIsLowLatencyBoost}"/>
                                    <TextBlock Text="When Reflex engages" Margin="0,0,0,6" Opacity="0.85"/>
                                    <RadioButton Content="End of Frame (smoother frame pacing)" GroupName="SkReflexEng" Margin="0,0,0,4"
                                                 IsChecked="{Binding Settings.SpecialKReflexIsEndOfFrame}"/>
                                    <RadioButton Content="Start of Frame (lower latency)" GroupName="SkReflexEng"
                                                 IsChecked="{Binding Settings.SpecialKReflexIsStartOfFrame}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="Frame pacing" FontWeight="Normal" Margin="0,0,0,6"/>
                                    <RadioButton Content="Default" GroupName="SkEnergy" Margin="0,0,0,4"
                                                 IsChecked="{Binding Settings.SpecialKEnergyIsDefault}"/>
                                    <RadioButton Content="Power Saving" GroupName="SkEnergy" Margin="0,0,0,4"
                                                 IsChecked="{Binding Settings.SpecialKEnergyIsPowerSaving}"/>
                                    <RadioButton Content="Max. Accuracy" GroupName="SkEnergy" Margin="0,0,0,4"
                                                 IsChecked="{Binding Settings.SpecialKEnergyIsMaxAccuracy}"/>
                                    <RadioButton Content="Custom" GroupName="SkEnergy" Margin="0,0,0,8"
                                                 IsChecked="{Binding Settings.SpecialKEnergyIsCustom}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Busy-wait percent" Margin="0,0,0,3" Opacity="0.85"/>
                                            <TextBox Text="{Binding Settings.SpecialKBusyWaitPercent, UpdateSourceTrigger=PropertyChanged}" Width="120" IsEnabled="{Binding Settings.SpecialKEnergyIsCustom}" MinHeight="36"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Busy-wait bias" Margin="0,0,0,3" Opacity="0.85"/>
                                            <TextBox Text="{Binding Settings.SpecialKBusyWaitBias, UpdateSourceTrigger=PropertyChanged}" Width="120" IsEnabled="{Binding Settings.SpecialKEnergyIsCustom}" MinHeight="36"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- Compatibility -->
                    <Expander x:Name="SpecialKCompatibilitySection" IsExpanded="False" Expanded="SpecialKSubsection_Expanded" Margin="0,0,0,6"><Expander.Header><TextBlock Text="Compatibility" FontWeight="SemiBold"/></Expander.Header>
                        <StackPanel Margin="0">
                            <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                                <CheckBox Content="Never inject Special K in games with anti-cheat"
                                          IsChecked="{Binding Settings.NeverInjectSpecialKForAntiCheatGames, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                                <CheckBox Content="Don't use Special K for Vulkan games (including DXVK)"
                                          IsChecked="{Binding Settings.DontUseSpecialKForVulkanGames, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,5,0,0">
                                <CheckBox Content="Fall back to RTSS if Special K fails to inject into a game"
                                          IsChecked="{Binding Settings.FallbackToRtssIfSpecialKFails, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="0,6,0,0" IsEnabled="{Binding Settings.ApplySpecialKSettingsToExistingProfiles}">
                                <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Window behavior" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                                                  SelectedValue="{Binding Settings.SpecialKWindowLayering, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  MinHeight="36">
                                            <ComboBoxItem Content="No Preference" Tag="{x:Static local:SpecialKWindowLayering.NoPreference}"/>
                                            <ComboBoxItem Content="Prevent Always-On-Top" Tag="{x:Static local:SpecialKWindowLayering.PreventAlwaysOnTop}"/>
                                            <ComboBoxItem Content="Force Always-On-Top" Tag="{x:Static local:SpecialKWindowLayering.ForceAlwaysOnTop}"/>
                                            <ComboBoxItem Content="Keep above other windows while multitasking" Tag="{x:Static local:SpecialKWindowLayering.MultitaskingOnTop}"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,0,0,5">
                                    <CheckBox Content="Disable controller vibration"
                                              IsChecked="{Binding Settings.SpecialKDisableRumble}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,0,0,5">
                                    <CheckBox Content="Disable Steam API"
                                              IsChecked="{Binding Settings.SpecialKSteamLogSilent}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,0,0,5">
                                    <CheckBox Content="Preload Steam overlay"
                                              IsChecked="{Binding Settings.SpecialKPreloadSteamOverlay}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4" Margin="0,0,0,5">
                                    <CheckBox Content="Disable Steam overlay"
                                              IsChecked="{Binding Settings.SpecialKDisableSteamOverlay}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{DynamicResource UiCard}" Padding="16,12" CornerRadius="4">
                                    <CheckBox Content="Force flip discard model"
                                              IsChecked="{Binding Settings.SpecialKUseFlipDiscard}" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Expander>

            <!-- Monitor-specific settings; responsive rows avoid clipped labels in Playnite's settings panel. -->
            <Expander x:Name="GlobalFpsLimitsSection" IsExpanded="False" Expanded="MainSection_Expanded" Margin="0,0,0,6"><Expander.Header><StackPanel Orientation="Horizontal"><Path Data="{DynamicResource SpeedIconGeometry}" Stroke="{DynamicResource ReShadeText}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,0,13,0"/><TextBlock Text="Global FPS limits" FontWeight="Normal" VerticalAlignment="Center"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,5,0,0">
                    <!-- LastChildFill must be false, otherwise the refresh button consumes the whole row. -->
                    <Border Style="{StaticResource DownloadCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Limit by" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LimitUnitOptions}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.LimitInputUnit, Mode=TwoWay}"
                                      VerticalAlignment="Center" MinHeight="36"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DownloadCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Detected monitors" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Refresh monitors"
                                    Command="{Binding RefreshDetectedMonitorsCommand}"
                                    MinWidth="140" MinHeight="36"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DownloadCard}" Visibility="{Binding HasMultipleMonitors, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Preferred monitor for games" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding PreferredMonitorOptions}"
                                      SelectedValue="{Binding Settings.PreferredGameMonitorDeviceName, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="DeviceName"
                                      MinHeight="36"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding MonitorResolutionEditors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding DisplayName}"
                                          IsExpanded="False" Margin="0,0,0,6">
                                    <StackPanel Margin="0,5,0,0">
                                        <Border Background="{DynamicResource UiCard}" CornerRadius="4" Padding="16,12" Margin="0,0,0,5">
                                        <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Monitor name" Foreground="{DynamicResource ReShadeTextMuted}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36"/>
                                        </Grid>
                                        <!-- Only the selected resolution is edited; others remain saved. -->
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                            <TextBlock Text="Resolution" Foreground="{DynamicResource ReShadeTextMuted}"
                                                       VerticalAlignment="Center" Margin="0,0,9,0"/>
                                            <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                                      Width="194" VerticalAlignment="Center" Margin="0,0,12,0" MinHeight="36"/>
                                        </WrapPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                                                <TextBlock Text="Refresh rate" Foreground="{DynamicResource ReShadeTextMuted}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox Width="80" ItemsSource="{Binding RefreshRates}"
                                                          SelectedItem="{Binding SelectedRefreshRateHz, Mode=TwoWay}"
                                                          VerticalAlignment="Center" MinHeight="36"/>
                                            </StackPanel>
                                            <Grid Margin="0,4,0,0"
                                                  Visibility="{Binding IsFixedRefresh, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Exact Hz" Foreground="{DynamicResource ReShadeTextMuted}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="1" Width="110" VerticalAlignment="Center"
                                                         InputMethod.IsInputMethodEnabled="False"
                                                         PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                         PreviewKeyDown="NumericTextBox_PreviewKeyDown"
                                                         DataObject.Pasting="NumericTextBox_Pasting"
                                                         Text="{Binding ExactSyncRefreshHzText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36"/>
                                                <TextBlock Grid.Column="2" Text="(blank = auto)" Foreground="{DynamicResource ReShadeTextMuted}"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                                                           Text="{Binding DetectedSyncRefreshHzLabel}"
                                                           Foreground="{DynamicResource ReShadeTextMuted}" Opacity="0.8"
                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ForcedModeLabel}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ReShadeTextMuted}" Opacity="0.85" Margin="0,0,0,0"/>
                                        </StackPanel>
                                        </Border>
                                        <ContentControl Content="{Binding SelectedProfile}"
                                                        ContentTemplate="{StaticResource MonitorLimitRows}"
                                                        IsEnabled="{Binding SelectedProfile.IsEditable}"/>

                                        <!-- Display type: independent for every monitor -->
                                        <Border Padding="16,12" Margin="0,0,0,5" Background="{DynamicResource UiCard}" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="Display type" Foreground="{DynamicResource ReShadeText}" FontWeight="Normal" Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <RadioButton Foreground="{DynamicResource ReShadeText}" Content="VRR (FreeSync / G-Sync)" IsChecked="{Binding IsVrr, Mode=TwoWay}" Margin="0,0,18,0"/>
                                                    <RadioButton Foreground="{DynamicResource ReShadeText}" Content="Fixed refresh" IsChecked="{Binding IsFixedRefresh, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <CheckBox Foreground="{DynamicResource ReShadeText}" Content="Detect automatically"
                                                          IsChecked="{Binding DisplayTypeAuto, Mode=TwoWay}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding VrrDetectionLabel}" Foreground="{DynamicResource ReShadeTextMuted}" Opacity="0.75"
                                                           TextWrapping="Wrap" Margin="20,0,0,2"/>
                                                <TextBlock Text="{Binding RefreshModesLabel}" Foreground="{DynamicResource ReShadeTextMuted}" Opacity="0.75"
                                                           TextWrapping="Wrap" Margin="20,0,0,6"/>

                                                <StackPanel Visibility="{Binding IsVrr, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding VrrSafeCapLabel}" Foreground="{DynamicResource ReShadeText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <Button Content="Apply to this monitor" Padding="8,2" Click="MonitorVrrSafeCap_Click" MinHeight="36"/>
                                                    </StackPanel>
                                                </StackPanel>


                                            </StackPanel>
                                        </Border>

                                        <!-- FPS presets: independent for every monitor -->
                                        <Border Padding="16,12" Margin="0,0,0,5" Background="{DynamicResource UiCard}" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Source={x:Static local:LimitUnits.State}, Path=PresetsLabel}" Foreground="{DynamicResource ReShadeText}" FontWeight="Normal" Margin="0,0,0,6"/>
                                                <!-- Refresh-rate matching only makes sense on fixed-refresh displays -->
                                                <StackPanel Visibility="{Binding IsFixedRefresh, Converter={StaticResource BoolToVis}}">
                                                    <CheckBox Foreground="{DynamicResource ReShadeText}" Content="Match presets to refresh rate (Hz, Hz/2, Hz/3 … down to 28 FPS)"
                                                              IsChecked="{Binding MatchPresetsToRefresh, Mode=TwoWay}" Margin="0,0,0,4"/>
                                                    <CheckBox Foreground="{DynamicResource ReShadeText}" Content="Use all refresh modes"
                                                              IsChecked="{Binding MatchPresetsAllModes, Mode=TwoWay}" Margin="20,0,0,4"/>
                                                    <CheckBox Foreground="{DynamicResource ReShadeText}" Content="Low-lag VSync (each preset 0.01 FPS below the exact step)"
                                                              IsChecked="{Binding LowLagVsync, Mode=TwoWay}"
                                                              Visibility="{Binding MatchPresetsToRefresh, Converter={StaticResource BoolToVis}}" Margin="20,0,0,4"/>
                                                    <TextBlock Text="{Binding MatchedPresetsPreview}" Foreground="{DynamicResource ReShadeTextMuted}" Opacity="0.8" Margin="20,0,0,4"
                                                               Visibility="{Binding MatchPresetsToRefresh, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Text="Saved presets" Foreground="{DynamicResource ReShadeTextMuted}" Margin="0,6,0,4"/>
                                                <ItemsControl ItemsSource="{Binding PresetEntries}" IsEnabled="{Binding PresetsEditable}" Margin="0,0,0,4">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource ReShadeControlBg}"
                                                                    BorderBrush="{DynamicResource ReShadeBorder}" BorderThickness="1"
                                                                    CornerRadius="12" Padding="8,3" Margin="0,0,6,6">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource ReShadeText}" VerticalAlignment="Center"/>
                                                                    <Button Content="×"
                                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            Click="RemoveMonitorPreset_Click"
                                                                            ToolTip="Remove preset"
                                                                            Width="20" Height="20" MinWidth="0" MinHeight="0"
                                                                            Padding="0" Margin="6,0,0,0"
                                                                            Background="Transparent" BorderThickness="0"
                                                                            Foreground="{DynamicResource ReShadeTextMuted}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                                    <Grid Width="120">
                                                    <TextBox Text="{Binding NewPresetText, UpdateSourceTrigger=PropertyChanged}"
                                                             PreviewKeyDown="MonitorPresetInput_PreviewKeyDown"
                                                             IsEnabled="{Binding PresetsEditable}"
                                                             HorizontalContentAlignment="Center"
                                                             Margin="0,0,0,0" MinHeight="36"/>
                                                    <TextBlock Text="{Binding Source={x:Static local:LimitUnits.State}, Path=PresetExample}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ReShadeTextMuted}" Opacity="0.6">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NewPresetText}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    </Grid>
                                                    <Button Content="Add preset" Click="AddMonitorPreset_Click"
                                                            IsEnabled="{Binding PresetsEditable}"
                                                            Style="{StaticResource CardPrimaryButton}"
                                                            MinWidth="104" Padding="8,4" MinHeight="36"/>
                                                    <TextBlock Text="or press Enter" Foreground="{DynamicResource ReShadeTextMuted}"
                                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </StackPanel>
                                                <!-- Optional low-refresh mode for displays with a lowered VRR range (e.g. CRU). -->
                                                <StackPanel Visibility="{Binding IsFixedRefresh, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                                                    <Border BorderBrush="{DynamicResource UiDivider}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
                                                    <TextBlock Text="RTSS Scanline Sync target (SyncScanline)" Foreground="{DynamicResource ReShadeText}" Margin="0,0,0,8"/>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="72"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider Grid.Column="0" Minimum="-500" Maximum="500" TickFrequency="1"
                                                                IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                                                                Value="{Binding DataContext.Settings.RtssScanlineSyncTarget, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding DataContext.Settings.RtssScanlineSyncTarget, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 HorizontalContentAlignment="Center" Margin="0,0,8,0" MinHeight="36"/>
                                                        <Button Grid.Column="2" Content="Default (-1)" Padding="8,2" Click="ResetScanlineTarget_Click" MinHeight="36"/>
                                                    </Grid>
                                                    <Border BorderBrush="{DynamicResource UiDivider}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
                                                    <CheckBox Foreground="{DynamicResource ReShadeText}" Content="VRR at lower Hz"
                                                              IsChecked="{Binding VrrRefreshRateEnabled, Mode=TwoWay}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="Useful for CRU-unlocked FreeSync. Don't enable if FreeSync already works properly."
                                                               Foreground="{DynamicResource ReShadeText}" Opacity="0.65" FontSize="12"
                                                               TextWrapping="Wrap" Margin="22,0,0,8"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Target Hz" Foreground="{DynamicResource ReShadeText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBox Width="64" Text="{Binding VrrTargetHzText, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding VrrFieldsLocked}" Margin="0,0,16,0" MinHeight="36"/>
                                                        <TextBlock Text="FPS threshold" Foreground="{DynamicResource ReShadeText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBox Width="64" Text="{Binding VrrFpsThresholdText, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding VrrFieldsLocked}" MinHeight="36"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- Hotkeys -->
            <Expander x:Name="HotkeysSection" Foreground="{DynamicResource ReShadeText}" IsExpanded="False" Expanded="MainSection_Expanded" Margin="0,0,0,6"><Expander.Header><StackPanel Orientation="Horizontal"><Path Data="{DynamicResource KeyboardIconGeometry}" Stroke="{DynamicResource ReShadeText}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,0,13,0"/><TextBlock Text="Hotkeys" FontWeight="Normal" VerticalAlignment="Center"/></StackPanel></Expander.Header>
                <StackPanel Margin="0,5,0,0">
                    <TextBlock Text="Playnite shortcuts" Style="{StaticResource SubHeading}" Margin="4,2,0,6"/>
                    <Border Style="{StaticResource DownloadCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Per-game panel" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource HotkeyCaptureTextBox}"
                                     Text="{Binding Settings.PlayniteMenuHotkey, Mode=OneWay}"
                                     IsReadOnly="True" Cursor="Hand"
                                     PreviewKeyDown="CapturePlayniteMenuHotkey_PreviewKeyDown"/>
                            <Button Grid.Column="2" Content="Clear" Margin="8,0,0,0" Padding="8,4" MinWidth="72"
                                    Click="ClearPlayniteMenuHotkey_Click" MinHeight="36"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource DownloadCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Global settings" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource HotkeyCaptureTextBox}"
                                     Text="{Binding Settings.GlobalSettingsHotkey, Mode=OneWay}"
                                     IsReadOnly="True" Cursor="Hand"
                                     PreviewKeyDown="CaptureGlobalSettingsHotkey_PreviewKeyDown"/>
                            <Button Grid.Column="2" Content="Clear" Margin="8,0,0,0" Padding="8,4" MinWidth="72"
                                    Click="ClearGlobalSettingsHotkey_Click" MinHeight="36"/>
                        </Grid>
                    </Border>
                    <Expander Foreground="{DynamicResource ReShadeText}" IsExpanded="False" Margin="0,6,0,0">
                    <Expander.Header><TextBlock Text="RTSS" FontWeight="Normal" VerticalAlignment="Center"/></Expander.Header>
                    <StackPanel Margin="0,5,0,0">
                    <Border Style="{StaticResource DownloadCard}" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*" MinWidth="170"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto" MinWidth="130"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource HotkeyCaptureTextBox}"
                                     Text="{Binding Settings.RtssOverlayHotkeyDisplay, Mode=OneWay}"
                                     IsReadOnly="True" Cursor="Hand" VerticalAlignment="Center"
                                     PreviewKeyDown="CaptureRtssOverlayHotkey_PreviewKeyDown"/>
                            <ComboBox Grid.Column="2" Foreground="{DynamicResource ReShadeText}"
                                      Background="{DynamicResource ReShadeControlBg}"
                                      BorderBrush="{DynamicResource ReShadeBorder}"
                                      VerticalAlignment="Center" MinHeight="36" SelectedIndex="0"
                                      ToolTip="Stored in RTSS (HotkeyHandler), so it works even when Playnite is closed. Esc clears it.">
                                <ComboBoxItem Content="Toggle RTSS overlay"/>
                            </ComboBox>
                            <Button Grid.Column="6" Foreground="{DynamicResource ReShadeTextMuted}"
                                    Background="Transparent" BorderThickness="0" ToolTip="Clear hotkey"
                                    Content="&#x2715;" Width="36" MinWidth="36" Padding="0" MinHeight="36"
                                    VerticalAlignment="Center" Click="ClearRtssOverlayHotkey_Click"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Settings.Hotkeys}" Margin="0,0,0,3">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DownloadCard}" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*" MinWidth="170"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource HotkeyCaptureTextBox}"
                                             Text="{Binding DisplayText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             VerticalAlignment="Center"
                                             Cursor="Hand"
                                             PreviewKeyDown="HotkeyCaptureBox_PreviewKeyDown"/>

                                    <ComboBox Grid.Column="2"
                                              Foreground="{DynamicResource ReShadeText}"
                                              Background="{DynamicResource ReShadeControlBg}"
                                              BorderBrush="{DynamicResource ReShadeBorder}"
                                              ItemsSource="{Binding DataContext.HotkeyActionOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              SelectedValue="{Binding Action}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              VerticalAlignment="Center"
                                              MinHeight="36"/>

                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsFpsLimitAction, Converter={StaticResource BoolToVis}}">
                                        <TextBox Text="{Binding FrameLimitText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource HotkeyCaptureTextBox}"
                                                 Width="72" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Source={x:Static local:LimitUnits.State}, Path=Suffix}" Foreground="{DynamicResource ReShadeTextMuted}" VerticalAlignment="Center" Opacity="0.9" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <ComboBox Grid.Column="4"
                                              Foreground="{DynamicResource ReShadeText}"
                                              Background="{DynamicResource ReShadeControlBg}"
                                              BorderBrush="{DynamicResource ReShadeBorder}"
                                              ItemsSource="{Binding DataContext.SyncModeOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              SelectedValue="{Binding SyncMode}"
                                              SelectedValuePath="Value"
                                              ItemTemplate="{StaticResource SyncModeOptionTemplate}"
                                              VerticalAlignment="Center"
                                              MinWidth="130"
                                              Visibility="{Binding IsSyncModeAction, Converter={StaticResource BoolToVis}}" MinHeight="36"/>

                                    <Button Grid.Column="6"
                                            Foreground="{DynamicResource ReShadeTextMuted}"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTip="Remove hotkey"
                                            Content="&#x2715;" Width="36" MinWidth="36"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveHotkeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" MinHeight="36"/>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+  Add hotkey"
                            Foreground="{DynamicResource ReShadeTextMuted}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ReShadeBorderHover}"
                            Command="{Binding AddHotkeyCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="8,4" MinHeight="40"/>
                    </StackPanel>
                    </Expander>

                    <Expander Foreground="{DynamicResource ReShadeText}" IsExpanded="False" Margin="0,6,0,0">
                    <Expander.Header><TextBlock Text="Special K" FontWeight="Normal" VerticalAlignment="Center"/></Expander.Header>
                    <StackPanel Margin="0,5,0,0">
                        <TextBlock Text="FPS presets only. Saved as Special K macros when a Special K game starts."
                                   Foreground="{DynamicResource ReShadeTextMuted}" Opacity="0.8" TextWrapping="Wrap" Margin="4,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding Settings.SpecialKMacroHotkeys}" Margin="0,0,0,3">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DownloadCard}" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*" MinWidth="130"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Style="{StaticResource HotkeyCaptureTextBox}"
                                                     Text="{Binding DisplayText, Mode=OneWay}"
                                                     IsReadOnly="True" VerticalAlignment="Center" Cursor="Hand"
                                                     PreviewKeyDown="SpecialKHotkeyCaptureBox_PreviewKeyDown"/>
                                            <ComboBox Grid.Column="2"
                                                      Foreground="{DynamicResource ReShadeText}"
                                                      Background="{DynamicResource ReShadeControlBg}"
                                                      BorderBrush="{DynamicResource ReShadeBorder}"
                                                      ItemsSource="{Binding DataContext.SpecialKPresetOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding FrameLimit}"
                                                      VerticalAlignment="Center" MinHeight="36">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LimitDisplay}">
                                                                    <Binding/>
                                                                    <Binding Source="{x:Static local:LimitUnits.State}" Path="IsFrametime"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="4"
                                                    Foreground="{DynamicResource ReShadeTextMuted}"
                                                    Background="Transparent" BorderThickness="0"
                                                    ToolTip="Remove hotkey"
                                                    Content="&#x2715;" Width="36" MinWidth="36" Padding="0"
                                                    VerticalAlignment="Center" MinHeight="36"
                                                    Command="{Binding DataContext.RemoveSpecialKMacroCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+  Add hotkey"
                                Foreground="{DynamicResource ReShadeTextMuted}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource ReShadeBorderHover}"
                                Command="{Binding AddSpecialKMacroCommand}"
                                HorizontalAlignment="Stretch"
                                Padding="8,4" MinHeight="40"/>
                    </StackPanel>
                    </Expander>
                </StackPanel>
            </Expander>

            <!-- Installed components -->
            <Expander x:Name="InstalledSection" Foreground="{DynamicResource ReShadeText}" IsExpanded="False" Expanded="InstalledSection_Expanded" Margin="0,0,0,6"><Expander.Header><StackPanel Orientation="Horizontal"><Path Data="M12,2.5 L20.5,7.2 L20.5,16.8 L12,21.5 L3.5,16.8 L3.5,7.2 Z M3.5,7.2 L12,12 L20.5,7.2 M12,12 L12,21.5" Stroke="{DynamicResource ReShadeText}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,0,13,0"/><TextBlock Text="Installed components" FontWeight="Normal" VerticalAlignment="Center"/></StackPanel></Expander.Header>
                <StackPanel x:Name="InstalledComponentsPanel" Margin="0,5,0,0"/>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
